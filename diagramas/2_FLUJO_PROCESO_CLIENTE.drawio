        <mxCell id="resumen" parent="1" style="swimlane;startSize=32;fillColor=#F5F5F5;swimlaneFillColor=#FFFFFF;strokeColor=#90A4AE;fontSize=13;fontStyle=1;fontColor=#263238;rounded=0;" value="¿Qué resuelve este sistema frente al control actual en hojas de Excel?" vertex="1">
          <mxGeometry height="165" width="1560" x="40" y="1325" as="geometry" />
        </mxCell>
        <mxCell id="c1" parent="resumen" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#81C784;strokeWidth=1.5;fontSize=11;fontColor=#212121;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;" value="&lt;b&gt;1. Registro único desde ventanilla&lt;/b&gt;&lt;br&gt;&lt;br&gt;En cuanto llegan las hojas impresas se capturan en un solo formulario limpio, evitando llenar y buscar en varios archivos de Excel." vertex="1">
          <mxGeometry height="98" width="355" x="25" y="48" as="geometry" />
        </mxCell>
        <mxCell id="c2" parent="resumen" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#E57373;strokeWidth=1.5;fontSize=11;fontColor=#212121;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;" value="&lt;b&gt;2. Control de pausados y Servicio Social&lt;/b&gt;&lt;br&gt;&lt;br&gt;Permite apartar ordenadamente los proyectos que quedan pausados porque el alumno no había liberado su Servicio Social, sin perder su historial." vertex="1">
          <mxGeometry height="98" width="355" x="405" y="48" as="geometry" />
        </mxCell>
        <mxCell id="c3" parent="resumen" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#B39DDB;strokeWidth=1.5;fontSize=11;fontColor=#212121;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;" value="&lt;b&gt;3. Reparto justo entre los docentes&lt;/b&gt;&lt;br&gt;&lt;br&gt;El encargado de asignar asesores ve al instante cuántos alumnos tiene cada profesor antes de elegirlo y generar su clave." vertex="1">
          <mxGeometry height="98" width="355" x="785" y="48" as="geometry" />
        </mxCell>
        <mxCell id="c4" parent="resumen" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#4FC3F7;strokeWidth=1.5;fontSize=11;fontColor=#212121;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;" value="&lt;b&gt;4. Avisos por Outlook y folios sin errores&lt;/b&gt;&lt;br&gt;&lt;br&gt;Genera folios P.A y P.B sin repetir, y avisa por correo institucional (Outlook) al estudiante en cuanto puede pasar por sus oficios." vertex="1">
