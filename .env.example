# Copia este archivo como .env y configura tus credenciales locales antes de ejecutar.
# Nunca subas el archivo .env real a GitHub.

# Conexión PostgreSQL 16 (usuario de mínimo privilegio app_residencias_user)
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=residencias_industrial_db
PGUSER=app_residencias_user
PGPASSWORD=CAMBIAR_POR_TU_PASSWORD_SEGURA

# Ruta opcional a libpq.so.5 (si no está en rutas estándar del sistema)
# LIBPQ_PATH=/usr/lib/x86_64-linux-gnu/libpq.so.5

# Servidor Flask
FLASK_HOST=::
FLASK_PORT=8000

# Opcional: envío directo de avisos por correo institucional (Microsoft Outlook SMTP)
# Si se dejan vacíos, el sistema abre Outlook Web prellenado con 1 clic y registra el aviso en BD.
OUTLOOK_EMAIL=
OUTLOOK_PASSWORD=
OUTLOOK_SMTP_HOST=smtp.office365.com
OUTLOOK_SMTP_PORT=587
